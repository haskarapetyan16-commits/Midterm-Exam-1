#include <iostream>
#include <cmath>

class DynamicArray {
private:
    int* elements;
    size_t currentSize;
    size_t allocatedCapacity;

public:
    DynamicArray() {
        currentSize = 0;
        allocatedCapacity = 1;
        elements = new int[allocatedCapacity];
    }

    ~DynamicArray() {
        delete[] elements;
    }

    void push_back(int number) {
        if (currentSize == allocatedCapacity) {
            size_t newCapacity;

            if (currentSize == 0)
                newCapacity = 2;
            else
                newCapacity = (size_t)ceil(currentSize * 1.6);

            int* newElements = new int[newCapacity];

            for (size_t i = 0; i < currentSize; ++i)
                newElements[i] = elements[i];

            delete[] elements;

            elements = newElements;
            allocatedCapacity = newCapacity;
        }

        elements[currentSize++] = number;
    }

    void pop_back() {
        if (currentSize > 0)
            currentSize--;
    }

    int operator[](size_t index) const {
        return elements[index];
    }

    size_t size() const {
        return currentSize;
    }

    size_t capacity() const {
        return allocatedCapacity;
    }
};

int main() {
    DynamicArray arr;

    arr.push_back(10);
    arr.push_back(20);
    arr.push_back(30);

    std::cout << "Size: " << arr.size()
              << ", capacity: " << arr.capacity() << "\n";

    arr.pop_back();

    std::cout << "After pop, size: " << arr.size()
              << ", capacity: " << arr.capacity() << "\n";

    std::cout << "Elements of array: ";

    for (size_t i = 0; i < arr.size(); ++i)
        std::cout << arr[i] << " ";

    return 0;
}
